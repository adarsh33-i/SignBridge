# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cloudflare Worker / Node tooling
node_modules/
.wrangler/
.dev.vars

# Sign videos are streamed from R2; keep manifest only in the app bundle.
/assets/signs/**/*.mp4
/asl/
/isl/

# Gloss student model corpus / checkpoints (regenerate with test/tools)
/training/data/
/training/runs/
/training/export/

# Video signer model: downloaded clips, extracted tracks, checkpoints and the
# free MediaPipe models. All regenerate with training/video/build_corpus.sh.
/training/video/data/
/training/video/runs/
/training/video/models/
**/__pycache__/
